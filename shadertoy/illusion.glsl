// =============================================================================
// ILLUSION - radial "pulse" mandala (optical-illusion lotus of interlocking
// scallop petals) blended with live video. Shadertoy, Image tab, single pass.
//
// iChannel0 = webcam or video   (filter LINEAR or MIPMAP, wrap CLAMP, vflip ON)
// iMouse    = click/drag to move the center (with CENTER_FROM_MOUSE 1)
//
// The pattern is fully procedural (no texture): log-polar scallop rings. Every
// ring of petals has a scalloped inner edge (circular arcs, sharp tips pointing
// outward); alternate rings are offset by half a petal, and the rainbow bands
// morph from one ring's scallops into the next -> interlocking pointed arches.
// =============================================================================

// ------------------------------ parameters -----------------------------------
#define PETALS            32      // 8..64    petals around the center (integer)
#define RING_FREQ         1.0     // 0.5..2   rings per petal width (1 = petals as tall as wide)
#define BAND_FREQ         2.0     // 1..6     color cycles per ring of petals (rounded to a whole number)
#define PETAL_CURVE       1.0     // 0.2..1.1 petal curvature (0.2 = nearly flat rings, 1 = deep pointed arches)
#define COLOR_SPEED       0.025   // 0..0.2   hue-wheel turns per second (0.025 = one per 40 s)
#define BAND_FLOW         0.25    // -1..1    bands flowing through each petal, cycles/s
#define ZOOM_SPEED        0.18    // -1..1    rings per second; + = flow outward (tunnel toward you)
#define ROTATION_SPEED    0.01    // -0.2..0.2 radians per second
#define PULSE_AMOUNT      0.35    // 0..1     breathing of petal size / band density (moire shimmer)
#define OVERLAY_STRENGTH  0.55    // 0..1     how strongly the pattern shows through
#define BLEND_MODE        0       // 0 screen, 1 overlay, 2 soft light, 3 multiply,
                                  // 4 additive glow, 5 luminance-keyed (strong in dark areas)
#define VIDEO_DISTORTION  0.6     // 0..2     rings bend around objects (video luminance gradient)
#define EDGE_INFLUENCE    0.5     // 0..1     video edges (Sobel) darken the pattern so forms read through
#define CENTER_FROM_MOUSE 1       // 1 = click/drag moves the center, 0 = always screen center
#define SATURATION        1.15    // 0..2     pattern saturation
#define GLOW              0.6     // 0..2     bright rainbow seams between petals + soft halo
#define MASK_MODE         0       // 0 none, 1 vignette (fade toward screen edges),
                                  // 2 only where the video is dark, 3 only where it is bright
#define LUMA_HUE          0.15    // 0..0.5   video brightness shifts the local hue (parts drift apart)

const float PI  = 3.14159265;
const float TAU = 6.28318531;

// ------------------------------ helpers --------------------------------------
mat2 rot2(float a) { float c = cos(a), s = sin(a); return mat2(c, s, -s, c); }
float luma(vec3 c) { return dot(c, vec3(0.299, 0.587, 0.114)); }
float lumaAt(vec2 uv) { return luma(texture(iChannel0, clamp(uv, 0.0, 1.0)).rgb); }

// Smooth, fully saturated rainbow (iq's smooth HSV): no kinks between hues.
vec3 hsv2rgbSmooth(vec3 c) {
    vec3 rgb = clamp(abs(mod(c.x * 6.0 + vec3(0.0, 4.0, 2.0), 6.0) - 3.0) - 1.0, 0.0, 1.0);
    rgb = rgb * rgb * (3.0 - 2.0 * rgb);
    return c.z * mix(vec3(1.0), rgb, c.y);
}

// Band palette. phase 0..1 runs blue -> cyan -> green -> yellow -> orange -> red
// -> magenta -> violet, then dips into dark navy, then repeats. hue = global drift.
vec3 palette(float phase, float hue) {
    float ph  = fract(phase);
    vec3  col = hsv2rgbSmooth(vec3(fract(0.667 - 0.92 * ph + hue), 1.0, 1.0));
    // fully navy at the wrap point (hides the violet -> blue hue jump), soft on both sides
    float dip = max(smoothstep(0.78, 0.92, ph), 1.0 - smoothstep(0.0, 0.08, ph));
    vec3  navy = hsv2rgbSmooth(vec3(fract(0.64 + hue), 0.9, 0.12));
    return mix(col, navy, clamp(dip, 0.0, 1.0));
}

// Hue rotation of an RGB color (keeps luminance roughly), for the global drift
// of anything not generated by palette().
vec3 hueShift(vec3 c, float turns) {
    const vec3 k = vec3(0.57735);
    float a = turns * TAU, ca = cos(a);
    return c * ca + cross(k, c) * sin(a) + k * dot(k, c) * (1.0 - ca);
}

vec3 saturateColor(vec3 c, float s) { return max(mix(vec3(luma(c)), c, s), 0.0); }

// Blend modes (base = video, blend = pattern), all in 0..1.
vec3 blendScreen(vec3 b, vec3 s)   { return 1.0 - (1.0 - b) * (1.0 - s); }
vec3 blendOverlay(vec3 b, vec3 s)  { return mix(2.0 * b * s, 1.0 - 2.0 * (1.0 - b) * (1.0 - s), step(0.5, b)); }
vec3 blendSoftLight(vec3 b, vec3 s) {                    // W3C soft light
    vec3 d = mix(((16.0 * b - 12.0) * b + 4.0) * b, sqrt(b), step(0.25, b));
    return mix(b - (1.0 - 2.0 * s) * b * (1.0 - b), b + (2.0 * s - 1.0) * (d - b), step(0.5, s));
}

// Sobel edge magnitude on luma (8 taps, spaced d in uv).
float sobel(vec2 uv, vec2 d) {
    float tl = lumaAt(uv + vec2(-d.x,  d.y)), tt = lumaAt(uv + vec2(0.0,  d.y)), tr = lumaAt(uv + d);
    float ll = lumaAt(uv - vec2( d.x, 0.0)),                                     rr = lumaAt(uv + vec2(d.x, 0.0));
    float bl = lumaAt(uv - d),                bb = lumaAt(uv - vec2(0.0,  d.y)), br = lumaAt(uv + vec2(d.x, -d.y));
    float gx = (tr + 2.0 * rr + br) - (tl + 2.0 * ll + bl);
    float gy = (tl + 2.0 * tt + tr) - (bl + 2.0 * bb + br);
    return length(vec2(gx, gy)) * 0.25;
}

// ------------------------------ petal field -----------------------------------
// Polar fold into log-polar "cell" space: x = petals around (period 1),
// y = rings outward (log radius). Conformal when RING_FREQ = 1, so petals keep
// their shape at every scale and simply shrink toward the center.
vec2 polarFold(vec2 p, float t) {
    float r = max(length(p), 1e-6);
    float a = atan(p.y, p.x) + t * ROTATION_SPEED;
    float k = float(PETALS) / TAU;
    return vec2(a * k, log(r) * k * RING_FREQ - t * ZOOM_SPEED);
}

// Petal profile across one petal (x = -0.5..0.5): a circular arc, 0 at the petal
// center, 1 at its edges with a vertical tangent -> sharp tips where neighbors meet.
float petalProfile(float x) {
    float a = clamp(2.0 * abs(x), 0.0, 1.0);
    return 1.0 - sqrt(1.0 - a * a);
}
float rowOffset(float n) { return 0.5 * mod(n, 2.0); }        // stagger by half a petal
float petalX(float n, float x) { return fract(x - rowOffset(n) + 0.5) - 0.5; }
// Scalloped inner edge of ring n: rises toward the petal edges (tips point outward).
float ringEdge(float n, float x, float C) { return n + C * petalProfile(petalX(n, x)); }

// Interlocking scallop petals. A point belongs to ring n when it lies between
// ring n's scalloped edge and ring n+1's (offset) edge; the band coordinate runs
// 0..1 across that gap, so the bands morph from one scallop row into the next
// (nested pointed arches + moire). C < 1 keeps the rings ordered.
// Returns (band coordinate 0..1, distance to the petal's side edge in cells).
vec2 petalField(vec2 c, float C) {
    float n = floor(c.y);
    if (c.y < ringEdge(n, c.x, C)) n -= 1.0;
    float e0 = ringEdge(n, c.x, C);
    float e1 = ringEdge(n + 1.0, c.x, C);
    float band = clamp((c.y - e0) / max(e1 - e0, 1e-4), 0.0, 1.0);
    return vec2(band, 0.5 - abs(petalX(n, c.x)));
}

// ------------------------------ main ------------------------------------------
void mainImage(out vec4 fragColor, in vec2 fragCoord) {
    vec2  res = iResolution.xy;
    vec2  uv  = fragCoord / res;
    float t   = iTime;
    vec3  video = texture(iChannel0, uv).rgb;
    float vl  = luma(video);

    // ---- center (screen center, or the mouse) ----
    vec2 center = 0.5 * res;
#if CENTER_FROM_MOUSE
    if (iMouse.x > 0.0 || iMouse.y > 0.0) center = iMouse.xy;
#endif
    vec2 p = (fragCoord - center) / res.y;

    // ---- video interaction 1: rings bend around objects ----
    // Blurred luminance gradient (4 taps, 6 px apart) displaces the pattern.
    vec2 e  = 6.0 / res;
    vec2 gL = vec2(lumaAt(uv + vec2(e.x, 0.0)) - lumaAt(uv - vec2(e.x, 0.0)),
                   lumaAt(uv + vec2(0.0, e.y)) - lumaAt(uv - vec2(0.0, e.y)));
    p += VIDEO_DISTORTION * 0.03 * gL;

    // ---- polar fold + log-radius rings + breathing pulse ----
    float r     = max(length(p), 1e-6);
    vec2  c     = polarFold(p, t);
    // breathing: petal curvature pulses gently (moire shimmer)
    float C     = clamp(0.85 * PETAL_CURVE * (1.0 + 0.08 * PULSE_AMOUNT * sin(t * 0.7)), 0.05, 0.95);
    vec2  pf    = petalField(c, C);

    // ---- band coloring with the global hue drift ----
    float hue   = t * COLOR_SPEED + 0.04 * log(r) + LUMA_HUE * vl;
    float bands = max(1.0, floor(BAND_FREQ + 0.5));       // whole number -> seamless between rings
    float phase = pf.x * bands - t * BAND_FLOW;
    vec3  pat   = palette(phase, hue);

    // thin bright rainbow seams where neighboring petals meet (converge like rays)
    // cell units per pixel, analytic (fwidth of the angle would jump at the atan seam)
    float fw     = float(PETALS) / (TAU * r * res.y);
    float seamPx = pf.y / fw;
    float seam   = 1.0 - smoothstep(0.4, 1.6, seamPx);
    float halo   = exp(-seamPx / 4.0);
    vec3  seamCol = hsv2rgbSmooth(vec3(fract(hue + c.y * 0.37 + 0.5), 0.8, 1.0));
    pat = mix(pat, seamCol, seam * clamp(GLOW, 0.0, 1.0));
    pat += seamCol * halo * 0.25 * GLOW;
    pat = saturateColor(pat, SATURATION);

    // ---- anti-aliasing of the dense center ----
    // Petal size in pixels (conformal: r * TAU / PETALS screen heights). Below a
    // few pixels the pattern would alias into flicker, so it fades to its own
    // average color, and a small solid blue dot marks the exact center.
    float cellPx = r * TAU / float(PETALS) * res.y;
    float detail = smoothstep(2.5, 9.0, cellPx);
    vec3  avgCol = hsv2rgbSmooth(vec3(fract(0.62 + hue), 0.55, 0.55));
    pat = mix(avgCol, pat, detail);
    float dotPx = r * res.y;
    pat = mix(pat, hsv2rgbSmooth(vec3(fract(0.66 + hue), 1.0, 0.95)), 1.0 - smoothstep(4.0, 6.0, dotPx));

    // ---- video interaction 2: environment edges read through the pattern ----
    float edge = smoothstep(0.05, 0.35, sobel(uv, 1.5 / res));
    pat *= 1.0 - 0.7 * EDGE_INFLUENCE * edge;

    // ---- blending with the environment ----
    vec3 blended;
#if BLEND_MODE == 0
    blended = blendScreen(video, pat);
#elif BLEND_MODE == 1
    blended = blendOverlay(video, pat);
#elif BLEND_MODE == 2
    blended = blendSoftLight(video, pat);
#elif BLEND_MODE == 3
    blended = video * pat;
#elif BLEND_MODE == 4
    blended = video + pat * (0.6 + 0.4 * GLOW);
#else
    blended = pat;                                        // luminance-keyed: strength set below
#endif

    float strength = OVERLAY_STRENGTH;
#if BLEND_MODE == 5
    strength *= 1.0 - smoothstep(0.15, 0.85, vl);         // strong in dark areas, weak in bright
#endif
#if MASK_MODE == 1
    strength *= 1.0 - smoothstep(0.35, 0.75, length((uv - 0.5) * vec2(res.x / res.y, 1.0)));
#elif MASK_MODE == 2
    strength *= 1.0 - smoothstep(0.2, 0.6, vl);
#elif MASK_MODE == 3
    strength *= smoothstep(0.4, 0.8, vl);
#endif

    vec3 col = mix(video, blended, clamp(strength, 0.0, 1.0));
    fragColor = vec4(clamp(col, 0.0, 1.0), 1.0);
}

// PERFORMANCE: 1 video + 4 gradient + 8 Sobel = 13 texture taps, plus ~6 circle
// distances of math per pixel: easily 60 fps at 1080p on a mid-range GPU.
// Most expensive: Sobel (8 taps) -> EDGE_INFLUENCE 0 and remove the call (-8).
// ANTI-ALIASING: the seams use fwidth for constant pixel width; the center
// fades below ~9 px petals (detail term) - raise 9.0 if you still see moire
// crawl near the center, lower it to keep more detail.
